# Required. Same Railway Postgres as rose-bot.
DATABASE_URL=postgres://user:pass@host:5432/railway

# better-auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# First admin (created if no user with this email exists)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# Optional. Set sslmode=disable for local Postgres without TLS.
# DATABASE_URL=postgres://postgres:rose@127.0.0.1:5432/rose?sslmode=disable
